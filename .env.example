# Weather. Defaults to the public Open-Meteo API. Point this at your own
# Open-Meteo instance if the public one ever becomes unreachable.
VITE_WEATHER_BASE_URL=https://api.open-meteo.com

# Sync. Leave empty for the recommended setup: app and API behind one hostname,
# so there is exactly one name that must stay reachable and no CORS involved.
# Set an absolute origin to split them, or `off` to run with no server at all.
VITE_SYNC_BASE_URL=

# There is deliberately no secret in this file. The shared passphrase is typed
# in once per device on the unlock screen and stored there, so the bundle you
# publish contains no credentials at all. The server side of the same secret is
# set in server/.env as PAIR_SECRET.
