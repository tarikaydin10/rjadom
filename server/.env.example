# The shared passphrase. The same string is typed once into each of the two
# devices on the unlock screen. Generate one:
#   node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
PAIR_SECRET=

# Port to listen on.
PORT=8787

# Where the JSON store lives. Put it on a volume that survives redeploys.
DATA_DIR=./server/data

# Only needed if the app is served from a different origin than this API.
# Leave empty for the single-origin deployment, which is the recommended one.
ALLOWED_ORIGIN=
