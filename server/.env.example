# One passphrase per side. Each person types their own, once, on their device —
# and that is what tells the server which side they are. Never the same value:
# with a shared passphrase the side can only be claimed in a header, and anyone
# holding it could pose as the other person and read their answer without
# writing one.
#
#   A = Hamburg      B = Kaliningrad
#
# Generate one:  node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
PAIR_SECRET_A=
PAIR_SECRET_B=

# Legacy: one passphrase for both sides. Still accepted so an existing
# deployment keeps running, but the server warns at startup and falls back to
# trusting the header. Prefer the two above.
# PAIR_SECRET=

# Port to listen on.
PORT=8787

# Where the JSON store lives. Put it on a volume that survives redeploys.
DATA_DIR=./server/data

# Only needed if the app is served from a different origin than this API.
# Leave empty for the single-origin deployment, which is the recommended one.
ALLOWED_ORIGIN=
